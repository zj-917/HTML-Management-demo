# syntax=docker/dockerfile:1
ARG SITE=internal

FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY server/package.json server/
COPY web/package.json web/
RUN pnpm install --frozen-lockfile --filter @hmp/web
COPY shared ./shared
COPY web ./web
RUN pnpm --filter @hmp/web build

FROM nginx:1.27-alpine AS runtime
ARG SITE
COPY --from=build /app/web/dist /usr/share/nginx/html
# deploy/nginx/generated/ 由 scripts/gen-nginx-config.mjs 在构建前生成（已 gitignore）。
COPY deploy/nginx/generated/nginx-${SITE}.conf /etc/nginx/conf.d/site.conf
# 官方镜像自带的 default.conf 也监听 80 且是 default_server，与本配置的
# `listen 80 default_server; return 444;` 冲突，必须删掉。
# 这里不跑 `nginx -t`：配置里的 upstream 指向 api:3000，构建阶段还没有 compose
# 网络，DNS 解析必然失败。校验放到 deploy.sh 启动之后执行。
RUN rm -f /etc/nginx/conf.d/default.conf && mkdir -p /srv
EXPOSE 80
