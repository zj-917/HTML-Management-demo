# ---- 数据库 ----
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=hmp
MYSQL_USER=hmp
MYSQL_PASSWORD=change-me

# ---- 应用 ----
JWT_SECRET=change-me-to-a-long-random-string-at-least-48-chars
JWT_EXPIRES_IN=12h

# 用户页面静态资源的签名密钥（图片/字体/视频用令牌放行，HTML 仍要登录）。
# 必填，且不要与 JWT_SECRET 相同。生成：openssl rand -hex 32
CONTENT_TOKEN_SECRET=change-me-another-long-random-string

MAX_UPLOAD_BYTES=104857600
MAX_EXTRACTED_BYTES=209715200
MAX_FILE_COUNT=500
MAX_SINGLE_FILE_BYTES=52428800

# ---- 端口绑定 ----
# 内网站点必须绑到内网网卡 IP（例如 10.0.0.5）。默认 127.0.0.1 是「失败关闭」：
# 忘了改的后果是本机之外访问不到，而不是把内网门户暴露到公网。
INTERNAL_BIND=127.0.0.1
INTERNAL_PORT=80
# 外网站点可以绑 0.0.0.0（由防火墙决定谁能连）
EXTERNAL_BIND=0.0.0.0
EXTERNAL_PORT=8080

# ---- 登录 Cookie ----
# 生产默认下发 Secure Cookie（只在 HTTPS 下回传）。
# 没有证书、直接用 HTTP 上线时必须设为 false，否则「登录成功但立刻又变未登录」。
# 配好 TLS 后改回 true。
COOKIE_SECURE=false

# ---- 业务时区 ----
# 访问统计按业务时区的自然日归档，相对 UTC 的偏移分钟数。480 = UTC+8
BUSINESS_TZ_OFFSET=480

# ---- 回收站 ----
# 回收站保留天数，超期由定时任务自动彻底删除（记录 + 磁盘文件）
RECYCLE_RETENTION_DAYS=30

# ---- 备份 ----
BACKUP_CRON=17 3 * * *
BACKUP_RETENTION_DAYS=14