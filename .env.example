# ---- 运行时 ----
NODE_ENV=development
PORT=3000

# ---- 数据库 ----
# 本地开发用 SQLite（零安装）；生产用 MySQL（见 deploy/docker-compose.yml）
DATABASE_URL="file:./dev.db"
# 生产示例:
# DATABASE_URL="mysql://hmp:hmp_password@db:3306/hmp"

# ---- 密钥（生产必须替换为随机长字符串）----
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN="12h"

# 用户页面静态资源的签名密钥（图片/字体/视频用令牌放行，HTML 仍要登录）。
# 留空则用开发默认值；生产必须设置为随机长字符串，且不要与 JWT_SECRET 相同。
CONTENT_TOKEN_SECRET=""

# ---- 配置目录（存放 config/sites.json 与 config/security-headers.json 的父目录）----
# 留空则自动向上查找；生产 Docker 中为 /app
APP_CONFIG_DIR=

# ---- 存储根目录 ----
# 所有上传内容与发布副本的根路径。内网容器挂载全量，外网容器只挂 ${STORAGE_ROOT}/public
STORAGE_ROOT="./data"

# ---- 上传限制 ----
MAX_UPLOAD_BYTES=104857600
MAX_EXTRACTED_BYTES=209715200
MAX_FILE_COUNT=500
MAX_SINGLE_FILE_BYTES=52428800

# ---- 业务时区 ----
# 访问统计按业务时区的自然日归档，相对 UTC 的偏移分钟数。480 = UTC+8
BUSINESS_TZ_OFFSET=480

# ---- 回收站 ----
# 回收站保留天数，超期自动彻底删除
RECYCLE_RETENTION_DAYS=30

# ---- 备份 ----
BACKUP_ENABLED=true
BACKUP_CRON="0 3 * * *"
BACKUP_DIR="./data/_backups"